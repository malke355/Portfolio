# Canonical origin used for metadata, sitemap, robots and OG images.
# Local development falls back to http://localhost:3000 automatically.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Set to 1 when deploying to a host without the Next.js image optimizer
# (GitHub Pages, S3, plain static hosting).
NEXT_PUBLIC_UNOPTIMIZED_IMAGES=

# ---------------------------------------------------------------------------
# DevBot (optional LLM mode)
# Without DEVBOT_API_KEY the assistant still works fully in local demo mode
# using the published portfolio knowledge base. Keys never go to the client.
# LLM mode requires a Node host (e.g. Vercel / `next start`) — GitHub Pages
# static export cannot run the API route.
# ---------------------------------------------------------------------------
DEVBOT_API_KEY=
DEVBOT_MODEL=gpt-4o-mini
# OpenAI-compatible base URL (OpenAI, Azure OpenAI, OpenRouter, etc.)
DEVBOT_BASE_URL=https://api.openai.com/v1
